generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Payload {
  id        String   @id @default(cuid())
  label     String
  target    String?
  source    String
  output    String
  config    String
  hash      String
  status    String   @default("unused")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AppSettings {
  id            String   @id @default("singleton")
  vaultEnabled  Boolean  @default(false)
  authAck       Boolean  @default(false)
  defaultIP     String?
  defaultPort   Int?
  defaultLang   String?
  theme         String   @default("amber")
  updatedAt     DateTime @updatedAt
}
